<Window x:Class="lab05p01_kolory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab05p01_kolory"
        mc:Ignorable="d"
        Title="MainWindow" 
        Height="450" 
        MinHeight="300" 
        MaxHeight="500"    
        Width="600"
        MinWidth="400" 
        MaxWidth="800" 
        >
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Rectangle 
        x:Name="probnik"
        Stroke="LightGray" 
        Fill="LightGray"
        Grid.Column="0"
        Grid.Row="0"
        Grid.ColumnSpan="3" />

        <CheckBox 
            x:Name="druk" 
            Content="Druk czeno-biały"
            Grid.Column="2" 
            Grid.Row="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="10" Checked="druk_Checked"
          />


        <Ellipse 
            x:Name="p1"
            Fill="Red"
            Grid.Column="0"
            Grid.Row="1"
            Width="25"
            Height="25"
             />

        <Ellipse 
            x:Name="p2"
            Fill="Green"
            Grid.Column="0"
            Grid.Row="2"
            Width="25"
            Height="25"
             />
        <Ellipse 
            x:Name="p3"
            Fill="Blue"
            Grid.Column="0"
            Grid.Row="3"
            Width="25"
            Height="25"
             />
        <Label 
            x:Name="labelR"
            Content="R: 255"
            Grid.Column="1"
            Grid.Row="1"
            VerticalAlignment="Center"
            Margin="10 0 0 0"
             />
        <Label 
           x:Name="labelG"
           Content="G: 255"
           Grid.Column="1"
           Grid.Row="2"
           VerticalAlignment="Center"
           Margin="10 0 0 0"
            />
        <Label 
           x:Name="labelB"
           Content="B: 255"
           Grid.Column="1"
           Grid.Row="3"
           VerticalAlignment="Center"
           Margin="10 0 0 0"
            />

        <Slider 
            x:Name="suwakR"
            Minimum="0"
            Maximum="255"
            Value="255"
            Grid.Column="2"
            Grid.Row="1"
            Margin="10 0 0 10"
            VerticalAlignment="Center" 
            ValueChanged="suwakR_ValueChanged"
             />
        <Slider 
            x:Name="suwakG"
            Minimum="0"
            Maximum="255"
            Value="255"
            Grid.Column="2"
            Grid.Row="2"
            Margin="10 0 0 10"
            VerticalAlignment="Center" 
            ValueChanged="suwakG_ValueChanged"
             />
        <Slider 
            x:Name="suwakB"
            Minimum="0"
            Maximum="255"
            Value="255"
            Grid.Column="2"
            Grid.Row="3"
            Margin="10 0 0 10"
            VerticalAlignment="Center"
            ValueChanged="suwakB_ValueChanged"
             />


    </Grid>
</Window>
